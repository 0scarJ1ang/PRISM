@article{chung2026vlasafety,
  venue={Preprints.org},
  selected={false},
  title={Towards Human-Centered Safety in Vision-Language-Action Robot Control: A Survey and Outlook},
  author={Nhat Chung and Toan Nguyen and Tianrun Hu and Yun Xing and Puming Jiang and Tuan-Anh Vu and Bohao Qu and Yedi Zhang and Yue Cao and Jie Zhang and Qing Guo and Yue Wang and Ming-Ming Cheng and Jin Song Dong and Cheston Tan and Harold Soh and David Hsu and Daniel Seita and Ivor Tsang},
  journal={Preprints},
  publisher={Preprints},
  year={2026},
  month={oct},
  doi={10.20944/preprints202610.2762.v1},
  abstract={As Vision-Language-Action (VLA) models couple perception and language understanding with physical action in human-shared environments, safety depends on whether they capture relevant information about people, environments, and social context and use it to shape robot behavior. We therefore center this survey on semantic-to-action causality towards human-centered robot safety, examining how safety-relevant semantics remain consequential for actions that preserve human well-being, environmental integrity, and social compliance. To trace this relationship from learning through execution to validation, we organize the literature across design-time methods that shape how safety-relevant features are learned, deployment-time mechanisms that govern their influence on behavior, and validation-time approaches that assess their effectiveness under safety-critical conditions. Across these stages, we identify four linked requirements, safety boundary coverage, semantic-to-action fidelity, contextual intervention and recovery, and incident-path validation, which describe how safety-relevant information must be captured, preserved, enforced, and evidenced. These requirements expose corresponding open challenges in sparse boundary examples, limited causal verifiability, gaps in intervention timing and recovery, and incomplete incident attribution.},
  description={A survey of human-centered safety for Vision-Language-Action models, tracing how safety-relevant semantics shape robot actions from design to deployment and validation.},
  keywords={Vision-Language-Action Models, Robot Safety, Human-Centered Robotics, Survey}
}

@article{jiang2026appl,
  preview={appl-demo.jpg},
  previewvideo={appl-demo.mp4},
  venue={arXiv},
  workshop={LEAP Workshop @ CoRL 2026},
  selected={true},
  title={Agent Priors-guided Policy Learning},
  author={Puming Jiang# and Tianrun Hu# and Haozhe Du and Yibo Li and Zhiwei Xue and Xinhu Li and Harold Soh},
  journal={arXiv preprint arXiv:2609.35690},
  year={2026},
  month={sep},
  eprint={2609.35690},
  archivePrefix={arXiv},
  primaryClass={cs.RO},
  url={https://agentics-robotics.github.io/APPL/},
  code={https://github.com/Agentics-robotics/Agent-Priors-guided-Policy-Learning},
  abstract={Robots that learn from a few demonstrations often require two forms of generalization. Compositional generalization recombines skills to solve new tasks, and skill generalization lets the learned policy behind each skill work in new situations. The two depend on each other, yet information is lost between composition and the skills it calls. Where a skill works is determined by the structure its policy is trained with, while composition sees the skill only through a separate description, such as a name, an instruction, or a symbolic operator, that omits this structure. Our key idea is to use each policy's structural prior as part of the interface between composition and the skill. A structural prior states what a behavior depends on, for example that a grasp depends only on the gripper's pose relative to the object. Built into training, it shapes where the policy generalizes; stated in language, it tells composition where the policy applies. We instantiate this idea in Agent Priors-guided Policy Learning (APPL). A construction agent segments complete demonstrations into reusable skills, proposes several structural priors for each skill, and trains and verifies one policy per prior. A runtime agent then selects among these prior-specific policies and composes them toward new task goals using their interfaces. Across MetaWorld and long-horizon ManiSkill tasks, APPL improves out-of-distribution skill generalization and enables previously unseen skill compositions; ablating the interface information substantially reduces performance. These results support the use of training-time structural assumptions as a bridge between skill learning and skill composition.},
  description={Structural priors connect learning reusable robot policies with understanding where they work and composing them for new tasks.},
  keywords={Robot Learning, Imitation Learning, Structural Priors, Skill Composition, Embodied AI}
}

@inproceedings{jiang2026gssip,
  preview={gssip-method.png},
  venue={R:SS},
  presentation={Oral},
  selected={true},
  title={Guided Streaming Stochastic Interpolant Policy},
  author={Puming Jiang# and Meiyi Wang# and Kelvin Lin and Ce Hao and Harold Soh},
  booktitle={Proceedings of Robotics: Science and Systems (RSS)},
  year={2026},
  arxivId={2605.10051v1},
  code={https://github.com/0scarJ1ang/guided-streaming-policy},
  abstract={Inference-time guidance is essential for steering generative robot policies toward dynamic objectives without retraining, yet existing methods are largely confined to chunk-based architectures that exhibit high latency and  lack the reactivity needed for test-time preference alignment or obstacle avoidance. In this work, we formally derive the optimal guidance term for Stochastic Interpolants (SI) by analyzing the value function's time evolution via the Backward Kolmogorov Equation, establishing a modified drift that theoretically guarantees sampling from a target distribution. We apply this framework to real-time control through the Streaming Stochastic Interpolant Policy (SSIP), which generalizes the deterministic Streaming Flow Policy (SFP). Unifying this guidance law with the streaming architecture enables fast and reactive control. To support diverse deployment needs, we propose two complementary mechanisms: training-free Stochastic Trajectory Ensemble Guidance (STEG) that computes gradients on-the-fly for zero-shot adaptation, and training-based Conditional Critic Guidance (CCG) for amortized inference. Empirical evaluations demonstrate that our guided streaming approach significantly outperforms conventional chunk-based policies in reactivity and provides superior, physically valid guidance for dynamic, unstructured environments.},
  description={Inference-time guidance steers streaming robot policies toward changing objectives without retraining, enabling fast and reactive control.},
  keywords={Robot Learning, Imitation Learning, Inference-Time Steering, Stochastic Interpolants, Streaming Policies}
}




